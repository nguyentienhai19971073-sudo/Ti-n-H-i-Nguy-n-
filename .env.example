# VIENEU_API_KEY: Primary Vietnamese TTS API key from https://vieneu.io/#/developer
# Starts with vn_sk_... (live) or vn_test_... (trial). Configure in Google AI Studio Secrets.
VIENEU_API_KEY=""

# VIENEU_TTS_URL: VieNeu Cloud speech synthesis endpoint (defaults to https://api.vieneu.io/api/v1/audio/speech).
VIENEU_TTS_URL="https://api.vieneu.io/api/v1/audio/speech"

# VIENEU_LOCAL_URL: Local VieNeuTTS HTTP server endpoint when running locally on Mac (exported via GitHub).
VIENEU_LOCAL_URL="http://127.0.0.1:8000/v1/audio/speech"

# GEMINI_API_KEY: Optional server-side key for Gemini peaceful greeting variation or optional Gemini TTS.
# Automatically injected by Google AI Studio Secrets Manager at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TIKTOK_SIGN_API_KEY: Optional EulerStream Sign API key for tiktok-live-connector.
TIKTOK_SIGN_API_KEY=""

# ELEVENLABS_API_KEY: Optional server-side API key when selecting ElevenLabs TTS provider.
ELEVENLABS_API_KEY=""

# OPENAI_API_KEY: Optional server-side API key when selecting OpenAI-compatible TTS provider.
OPENAI_API_KEY=""

# OPENAI_TTS_ENDPOINT: Optional custom OpenAI-compatible TTS endpoint URL.
OPENAI_TTS_ENDPOINT="https://api.openai.com/v1/audio/speech"

# VITE_BUDDHA_MODEL_URL: Optional path or URL to an external 3D Buddha statue (.glb or .gltf).
# Leave empty to use the built-in sculpted 24K Gold Buddha & Lotus Throne.
VITE_BUDDHA_MODEL_URL=""

# ADMIN_ACCESS_TOKEN: Optional secret token to protect gift management mutation APIs (/api/gifts/*)
# in public/deployed environments. Leave empty during local or AI Studio preview development.
ADMIN_ACCESS_TOKEN=""


